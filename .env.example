# Copier en .env (jamais commité : voir .gitignore) puis remplacer TOUTES les valeurs.
# Générer des valeurs aléatoires :  openssl rand -base64 32
#   (PowerShell : [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 })))
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SECRET=change-me-with-at-least-32-random-chars
MINIO_ROOT_USER=biblio-minio
MINIO_ROOT_PASSWORD=change-me-min-8-chars
SEED_ADMIN_EMAIL=admin@biblio.local
SEED_ADMIN_PASSWORD=change-me-admin
GRAFANA_ADMIN_PASSWORD=change-me
# Image du stockage objet S3 (MinIO n'a plus d'image officielle). Alternative si besoin :
# MINIO_IMAGE=cgr.dev/chainguard/minio:latest
